{
	"configurations": [
		{
			"name": "DaisyVerb",
			"cStandard": "c17",
			"compilerPath": "/usr/bin/arm-none-eabi-gcc",
			"cppStandard": "c++20",
			"defines": [
					"_DEBUG",
				"UNICODE",
				"_UNICODE"
			],
			"includePath": [
				"${workspaceFolder}/**",
				"${workspaceFolder}/src//**",
				"${workspaceFolder}/libs/libDaisy//**",
				"${workspaceFolder}/libs/DaisySP//**"
			],
			"intelliSenseMode": "linux-gcc-arm"
		}
	],
	"version": 4
}
